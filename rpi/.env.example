# Smart Stick RPi backend configuration template.
# Copy to `.env` and adjust for the target environment.

# --- Runtime ---
SMART_STICK_ENV=dev
LOG_LEVEL=INFO

# --- Storage paths ---
DATA_DIR=/home/pi/data
DATABASE_PATH=/home/pi/data/smartstick.db
CSV_LOG_PATH=/home/pi/data/electrical_parameters.csv

# --- API ---
API_HOST=0.0.0.0
API_PORT=5000
API_CORS_ORIGINS=*

# --- Detection ---
DETECTION_ENABLED=true
DETECTION_FPS=6
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.45
YOLO_IMG_SIZE=640

# --- Camera ---
CAMERA_DEVICE=/dev/video0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# --- Location ---
# GPS data arrives inside the ESP32 telemetry frame; this is only the
# cadence at which the location service samples and persists a fix.
GPS_UPDATE_INTERVAL_S=5

# Note: the LiDAR, both ultrasonic sensors and the GPS are owned by the
# ESP32 firmware. The RPi consumes them through the ESP32 telemetry frame
# (see the ESP32 section below) — there are no direct I2C / GPIO sensor
# settings on the RPi.

# --- Battery ---
BATTERY_UPDATE_INTERVAL_S=30
BATTERY_WARN_50=true
BATTERY_WARN_25=true
BATTERY_WARN_10=true

# --- ESP32 (SPI sensor hub) ---
# The ESP32 is an SPI slave; the RPi is the master. Each transfer is a
# fixed 64-byte full-duplex frame: the ESP32 returns a 15-byte telemetry
# packet, the RPi sends a 4-byte command packet (both zero-padded).
ESP32_SPI_BUS=0
ESP32_SPI_DEVICE=0
ESP32_SPI_SPEED_HZ=1000000
ESP32_SPI_MODE=0
# GPIO (BCM) wired to the ESP32 IRQ line; LOW = fresh telemetry ready.
ESP32_IRQ_PIN=23
# A telemetry packet older than this many seconds is treated as stale.
ESP32_FRAME_TIMEOUT_S=1.0
# Synthetic-detection distances used when the firmware raises a flag.
ESP32_DROP_DETECTION_M=0.25
ESP32_OVERHEAD_DETECTION_M=0.5

# UART bridge — battery telemetry only (not part of the SPI packet).
ESP32_PORT=/dev/serial0
ESP32_BAUDRATE=115200

# --- Output ---
HAPTICS_PIN=26
BUZZER_PIN=27

# --- Alerting ---
ALERT_COOLDOWN_S=3.0
ELECTRICAL_LOG_INTERVAL_S=30

# --- TTS ---
TTS_RATE_WPM=80
TTS_VOLUME=1.0
